# Required for the local demo authentication flow.
# Generate a long random value with: python -c "import secrets; print(secrets.token_urlsafe(48))"
RECONGRAPH_AUTH_SECRET_KEY=replace-with-a-long-random-secret
RECONGRAPH_DEMO_ADMIN_USERNAME=admin
RECONGRAPH_DEMO_ADMIN_PASSWORD=replace-with-a-strong-admin-password
RECONGRAPH_DEMO_AUDITOR_USERNAME=auditor
RECONGRAPH_DEMO_AUDITOR_PASSWORD=replace-with-a-strong-auditor-password
